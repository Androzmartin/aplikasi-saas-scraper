# --- App ---
APP_NAME="UMKM Scraper SaaS"
ENVIRONMENT=development
API_PREFIX=/api

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=umkm_scraper

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Object storage (local filesystem driver for MVP) ---
STORAGE_DIR=./storage

# --- Scraper ---
SCRAPER_USER_AGENT=UMKMScraperBot/1.0 (+https://example.com/bot)
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_PAGES_PER_SITE=6
SCRAPER_DELAY_SECONDS=1.0
SCRAPER_WORKER_CONCURRENCY=3
SCRAPER_MAX_RETRIES=2
SCRAPER_RESPECT_ROBOTS=true

# --- Quota ---
DEFAULT_MONTHLY_JOB_QUOTA=500

# --- Seed bootstrap admin (created on first startup only) ---
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Internal Admin

# --- Optional AI enrichment (falls back to deterministic templates when unset) ---
AI_ENABLED=false
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Screenshots & ekspor PDF (opsional, butuh Playwright + browser) ---
# pip install playwright && playwright install chromium
SCREENSHOT_ENABLED=false
SCREENSHOT_ON_SCRAPE=false
SCREENSHOT_TIMEOUT_SECONDS=30
SCREENSHOT_FULL_PAGE=false
# Isi jika browser berada di lokasi non-standar
SCREENSHOT_BROWSER_PATH=

# --- Approval admin ---
# true = hasil redesign harus disetujui admin internal sebelum bisa diunduh user
REQUIRE_REDESIGN_APPROVAL=false

# --- Duitku payment gateway ---
# Ambil dari dashboard Duitku (Proyek > Detail).
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# false = sandbox (https://sandbox.duitku.com), true = produksi (https://passport.duitku.com)
DUITKU_PRODUCTION=false
DUITKU_EXPIRY_MINUTES=60

# WAJIB di produksi: URL publik API ini, dipakai menyusun callbackUrl yang
# dipanggil Duitku. Harus bisa diakses dari internet (bukan localhost).
PUBLIC_API_BASE_URL=http://localhost:8000
# URL publik frontend, tujuan redirect setelah user selesai membayar.
PUBLIC_APP_BASE_URL=http://localhost:5173
